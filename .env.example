# Copy this file to .env and fill in your own values. Never commit .env.

# ---- Clerk (login) -> https://dashboard.clerk.com ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# ---- Cloudinary (video and image storage) -> https://console.cloudinary.com ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Database: PostgreSQL (for example Neon) -> https://console.neon.tech ----
DATABASE_URL=
# Optional. Neon: put the DIRECT (non-pooled) connection string here.
# "npm run db:deploy" and "npm run db:migrate" use it when it is set.
DIRECT_URL=

# ---- AI studio (optional) -> https://platform.openai.com ----
# Without a key the app works normally and the AI studio switches itself off.
OPENAI_API_KEY=OPENAI_API_KEY
# OPENAI_MODEL=gpt-4.1-mini
# How many AI analyses one user may run in 24 hours (default 5)
# AI_DAILY_LIMIT=5

# ---- Tests (optional): an empty PostgreSQL database used only by "npm test" ----
# TEST_DATABASE_URL=
